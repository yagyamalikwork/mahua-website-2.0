{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(python scripts/:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run lint)",
      "PowerShell(npm install)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(python scripts/:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git reset --hard:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
